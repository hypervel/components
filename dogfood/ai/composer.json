{
    "name": "hypervel/ai-demo",
    "description": "Maintainer demo for the Hypervel AI SDK.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "hypervel/components": "0.4.x-dev"
    },
    "license": "MIT",
    "autoload-dev": {
        "psr-4": {
            "Hypervel\\Dogfood\\Ai\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "name": "components",
        "type": "path",
        "url": "../..",
        "options": {
            "symlink": true,
            "versions": {
                "hypervel/components": "0.4.x-dev"
            }
        }
    }],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "~13.4.3",
        "mockery/mockery": "^1.6.15",
        "fakerphp/faker": "^1.24"
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "testbench package:test --no-progress",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
