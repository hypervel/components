<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         defaultTestSuite="Hypervel Packages Test Suite"
         bootstrap="tests/bootstrap.php"
         beStrictAboutTestsThatDoNotTestAnything="false"
         colors="true"
         defaultTimeLimit="60"
         enforceTimeLimit="true"
         failOnRisky="true"
         failOnWarning="true"
         processIsolation="false"
         stopOnError="false"
         stopOnFailure="false"
         backupStaticProperties="false"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true">
    <testsuites>
        <testsuite name="Hypervel Packages Test Suite">
            <directory suffix="Test.php">./tests</directory>
            <!-- PHPStan analyzer tests run through phpunit.phpstan.xml.dist. -->
            <exclude>./tests/PHPStan</exclude>
        </testsuite>
        <testsuite name="database">
            <directory>./tests/Integration/Database</directory>
            <directory>./tests/Integration/*/Database</directory>
            <!-- Only direct package tests are shared. Each driver suite includes its own subdirectories. -->
            <exclude>./tests/Integration/*/Database/*/</exclude>
        </testsuite>
        <testsuite name="mysql">
            <directory>./tests/Integration/*/Database/MySql</directory>
        </testsuite>
        <testsuite name="mariadb">
            <directory>./tests/Integration/*/Database/MariaDb</directory>
        </testsuite>
        <testsuite name="pgsql">
            <directory>./tests/Integration/*/Database/Postgres</directory>
        </testsuite>
        <testsuite name="sqlite">
            <directory>./tests/Integration/*/Database/Sqlite</directory>
        </testsuite>
    </testsuites>
    <extensions>
        <bootstrap class="Hypervel\Testing\PHPUnit\AfterEachTestExtension" />
    </extensions>
    <php>
        <ini name="error_reporting" value="-1"/>
        <!-- Keep isolated-child startup errors on stderr so PHPUnit reports their cause. -->
        <ini name="display_errors" value="stderr"/>
        <ini name="display_startup_errors" value="on"/>
        <ini name="memory_limit" value="1024M"/>
        <server name="HYPERVEL_PARALLEL_TESTING" value="1"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Fix terminal dimensions so console-output assertions do not depend
            on the developer's terminal size.
        -->
        <env name="COLUMNS" value="80" force="true"/>
        <env name="LINES" value="24" force="true"/>
        <!-- Prevent unrelated Testbench subprocesses from exporting telemetry. Not forced, so jobs can opt in. -->
        <env name="OTEL_TRACES_EXPORTER" value="none"/>
        <env name="OTEL_METRICS_EXPORTER" value="none"/>
        <env name="OTEL_LOGS_EXPORTER" value="none"/>
    </php>
</phpunit>
