includes:
    - src/database/extension.neon
    - src/foundation/extension.neon
    - src/head/extension.neon
    - src/scout/extension.neon

parameters:
    level: max
    tmpDir: .cache/phpstan-types
    scanDirectories:
        - src/database/src/PHPStan
        - src/foundation/src/PHPStan
        - src/head/src/PHPStan
        - src/scout/src/PHPStan
    paths:
        - types
