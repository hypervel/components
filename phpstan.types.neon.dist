includes:
    - src/phpstan/extension.neon

parameters:
    level: max
    tmpDir: .cache/phpstan-types
    scanDirectories:
        - src/phpstan/src
    paths:
        - types
    # These fixtures assert the types of supported APIs, not authoring policy.
    noLegacyModelScopes: false
    noLegacyModelProperties: false
    noLegacyQueueProperties: false
    noPipeSeparatedValidationRules: false
    checkModelMethodVisibility: false
    noUnnecessaryEnumerableToArrayCalls: false
