        "typecheck:wayfinder": "pnpm --dir src/wayfinder typecheck"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "terser": "5.51.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    }
}
