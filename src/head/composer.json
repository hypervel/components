{
    "name": "hypervel/head",
    "description": "The Hypervel Head package.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "head",
        "seo",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "hypervel/collections": "^0.4",
        "hypervel/conditionable": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/foundation": "^0.4",
        "hypervel/http": "^0.4",
        "hypervel/macroable": "^0.4",
        "hypervel/routing": "^0.4",
        "hypervel/support": "^0.4",
        "hypervel/view": "^0.4",
        "psr/log": "^3.0",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "suggest": {
        "hypervel/inertia": "Required for Inertia head management (^0.4)."
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Head\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Head\\HeadServiceProvider"
            ],
            "aliases": {
                "Head": "Hypervel\\Head\\Facades\\Head"
            }
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
