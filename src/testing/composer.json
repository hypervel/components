{
    "name": "hypervel/testing",
    "description": "The Hypervel Testing package.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "testing",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.2",
        "hypervel/attributes": "^0.4",
        "hypervel/auth": "^0.4",
        "hypervel/broadcasting": "^0.4",
        "hypervel/bus": "^0.4",
        "hypervel/cache": "^0.4",
        "hypervel/collections": "^0.4",
        "hypervel/conditionable": "^0.4",
        "hypervel/config": "^0.4",
        "hypervel/console": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/cookie": "^0.4",
        "hypervel/coordinator": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/database": "^0.4",
        "hypervel/di": "^0.4",
        "hypervel/encryption": "^0.4",
        "hypervel/events": "^0.4",
        "hypervel/filesystem": "^0.4",
        "hypervel/foundation": "^0.4",
        "hypervel/guzzle-promises": "^3.1",
        "hypervel/http": "^0.4",
        "hypervel/log": "^0.4",
        "hypervel/macroable": "^0.4",
        "hypervel/mail": "^0.4",
        "hypervel/notifications": "^0.4",
        "hypervel/pagination": "^0.4",
        "hypervel/pipeline": "^0.4",
        "hypervel/process": "^0.4",
        "hypervel/prompts": "^0.4",
        "hypervel/queue": "^0.4",
        "hypervel/rate-limiter": "^0.4",
        "hypervel/redis": "^0.4",
        "hypervel/reflection": "^0.4",
        "hypervel/routing": "^0.4",
        "hypervel/server": "^0.4",
        "hypervel/server-process": "^0.4",
        "hypervel/session": "^0.4",
        "hypervel/support": "^0.4",
        "hypervel/translation": "^0.4",
        "hypervel/validation": "^0.4",
        "hypervel/view": "^0.4",
        "hypervel/websocket-server": "^0.4",
        "mockery/mockery": "^1.6.15",
        "nesbot/carbon": "^3.13.1",
        "symfony/console": "^8.1.10",
        "symfony/http-foundation": "^8.1.11",
        "symfony/process": "^8.1",
        "vlucas/phpdotenv": "^5.6.1"
    },
    "suggest": {
        "brianium/paratest": "Required to run tests in parallel (^7.27.2).",
        "phpunit/phpunit": "Required to use Hypervel's testing assertions and PHPUnit integration (~13.4.3)."
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Testing\\": "src/"
        }
    },
    "bin": [
        "bin/hypervel-test-profile"
    ],
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Testing\\TestingServiceProvider"
            ]
        }
    }
}
