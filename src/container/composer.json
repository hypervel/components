{
    "name": "hypervel/container",
    "description": "The Hypervel Container package.",
    "license": "MIT",
    "keywords": [
        "php",
        "container",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-swoole": "^6.2.2",
        "hypervel/collections": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/reflection": "^0.4",
        "psr/container": "^2.0.1"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Hypervel\\Container\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        }
    }
}
