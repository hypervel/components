{
    "name": "hypervel/notifications",
    "description": "The Hypervel Notifications package.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "notifications",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.1 || ^8.2",
        "hypervel/broadcasting": "^0.4",
        "hypervel/bus": "^0.4",
        "hypervel/collections": "^0.4",
        "hypervel/conditionable": "^0.4",
        "hypervel/config": "^0.4",
        "hypervel/console": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/database": "^0.4",
        "hypervel/macroable": "^0.4",
        "hypervel/mail": "^0.4",
        "hypervel/queue": "^0.4",
        "hypervel/support": "^0.4",
        "nesbot/carbon": "^3.13.1",
        "psr/http-message": "^2.0",
        "symfony/console": "^8.1",
        "symfony/mailer": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Notifications\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Notifications\\NotificationServiceProvider"
            ]
        }
    }
}
