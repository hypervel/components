{
    "name": "hypervel/contracts",
    "description": "The Hypervel Contracts package.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "contracts",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "monolog/monolog": "^3.10",
        "nesbot/carbon": "^3.13.1",
        "psr/container": "^2.0.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/console": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Contracts\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        }
    }
}
