{
    "name": "hypervel/filesystem",
    "description": "The Hypervel Filesystem package.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "swoole",
        "filesystem",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.322.9",
        "guzzlehttp/psr7": "^2.13 || ^3.1",
        "hypervel/collections": "^0.4",
        "hypervel/conditionable": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/http": "^0.4",
        "hypervel/macroable": "^0.4",
        "hypervel/object-pool": "^0.4",
        "hypervel/support": "^0.4",
        "league/flysystem": "^3.25.1",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "league/flysystem-path-prefixing": "^3.25.1",
        "league/flysystem-read-only": "^3.25.1",
        "psr/http-message": "^2.0",
        "symfony/finder": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "suggest": {
        "ext-fileinfo": "Required to use the Filesystem class.",
        "ext-ftp": "Required to use the Flysystem FTP driver.",
        "hypervel/image": "Required to create images from stored files (^0.4).",
        "league/flysystem-ftp": "Required to use the Flysystem FTP driver (^3.25.1).",
        "league/flysystem-google-cloud-storage": "Required to use the Flysystem Google Cloud Storage driver (^3.25.1).",
        "league/flysystem-sftp-v3": "Required to use the Flysystem SFTP driver (^3.25.1).",
        "symfony/filesystem": "Required to use relative symbolic links (^8.1).",
        "symfony/mime": "Required to enable support for guessing extensions (^8.1)."
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Filesystem\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Filesystem\\FilesystemServiceProvider"
            ]
        }
    }
}
