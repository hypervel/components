{
    "name": "hypervel/mcp",
    "description": "Build MCP servers and clients for Hypervel applications.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "mcp",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-swoole": "^6.3.0RC1",
        "hypervel/auth": "^0.4",
        "hypervel/cache": "^0.4",
        "hypervel/collections": "^0.4",
        "hypervel/conditionable": "^0.4",
        "hypervel/config": "^0.4",
        "hypervel/console": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/database": "^0.4",
        "hypervel/engine": "^0.4",
        "hypervel/filesystem": "^0.4",
        "hypervel/foundation": "^0.4",
        "hypervel/http": "^0.4",
        "hypervel/json-schema": "^0.4",
        "hypervel/macroable": "^0.4",
        "hypervel/process": "^0.4",
        "hypervel/routing": "^0.4",
        "hypervel/support": "^0.4",
        "hypervel/testing": "^0.4",
        "hypervel/validation": "^0.4",
        "league/flysystem": "^3.25.1",
        "psr/http-message": "^2.0",
        "symfony/console": "^8.1.2",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/process": "^8.1",
        "symfony/routing": "^8.1"
    },
    "suggest": {
        "hypervel/passport": "Required to authorize MCP clients using OAuth (^0.4).",
        "phpunit/phpunit": "Required to use MCP testing assertions (^13.0)."
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Mcp\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "aliases": {
                "Mcp": "Hypervel\\Mcp\\Facades\\Mcp"
            },
            "providers": [
                "Hypervel\\Mcp\\Server\\McpServiceProvider"
            ]
        }
    }
}
