<?php

declare(strict_types=1);

namespace {{ namespace }};

use Hypervel\Doctor\Contracts\Fixable;
use Hypervel\Doctor\Diagnostic;
use Hypervel\Doctor\Results\DiagnosticResult;
use Hypervel\Doctor\Results\FixResult;
use Hypervel\Doctor\Results\Message;

class {{ class }} extends Diagnostic implements Fixable
{
    /**
     * Get the diagnostic's named message definitions.
     *
     * @return array<string, string|Message>
     */
    protected function messages(): array
    {
        return [
            'passed' => 'The check passed.',
            'failed' => Message::make(
                summary: 'The check failed.',
                remediation: 'Describe how to resolve the failure.',
                confirmation: 'Apply the fix?',
            ),
            'fixed' => 'The failure was fixed.',
            'fix-failed' => 'The failure could not be fixed.',
        ];
    }

    /**
     * Run the diagnostic.
     */
    public function check(): DiagnosticResult
    {
        return $this->fail('failed')->fixable();
    }

    /**
     * Fix the diagnostic.
     */
    public function fix(DiagnosticResult $result, ?string $option = null): FixResult
    {
        return $this->fixed('fixed');
    }
}
