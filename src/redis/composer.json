{
    "name": "hypervel/redis",
    "description": "The Hypervel Redis package.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "redis",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "ext-swoole": "^6.2.2",
        "hypervel/collections": "^0.4",
        "hypervel/config": "^0.4",
        "hypervel/connection-pool": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/coordinator": "^0.4",
        "hypervel/core": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/engine": "^0.4",
        "hypervel/macroable": "^0.4",
        "hypervel/support": "^0.4",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-redis": "Required to use the phpredis connector (^6.1)."
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Redis\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Redis\\RedisServiceProvider"
            ]
        }
    }
}
