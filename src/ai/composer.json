{
    "name": "hypervel/ai",
    "description": "The official AI SDK for Hypervel.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "ai",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "ext-swoole": "^6.2.2",
        "guzzlehttp/psr7": "^2.13 || ^3.1",
        "hypervel/broadcasting": "^0.4",
        "hypervel/cache": "^0.4",
        "hypervel/collections": "^0.4",
        "hypervel/conditionable": "^0.4",
        "hypervel/config": "^0.4",
        "hypervel/console": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/database": "^0.4",
        "hypervel/engine": "^0.4",
        "hypervel/filesystem": "^0.4",
        "hypervel/foundation": "^0.4",
        "hypervel/http": "^0.4",
        "hypervel/json-schema": "^0.4",
        "hypervel/macroable": "^0.4",
        "hypervel/pagination": "^0.4",
        "hypervel/pipeline": "^0.4",
        "hypervel/prompts": "^0.4",
        "hypervel/queue": "^0.4",
        "hypervel/reflection": "^0.4",
        "hypervel/support": "^0.4",
        "hypervel/validation": "^0.4",
        "laravel/serializable-closure": "^2.0.11",
        "psr/http-message": "^2.0",
        "symfony/console": "^8.1.2",
        "symfony/finder": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "conflict": {
        "aws/aws-sdk-php": "<3.369.1"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required to use the Bedrock provider (^3.369.1).",
        "hypervel/mcp": "Required to use MCP client or server tools with Hypervel AI agents."
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Ai\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Ai\\AiServiceProvider"
            ]
        }
    }
}
