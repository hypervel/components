{
    "name": "hypervel/encryption",
    "description": "The Hypervel Encryption package.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "encryption",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "hypervel/config": "^0.4",
        "hypervel/console": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/filesystem": "^0.4",
        "hypervel/support": "^0.4",
        "symfony/console": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Encryption\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Encryption\\EncryptionServiceProvider"
            ]
        }
    }
}
