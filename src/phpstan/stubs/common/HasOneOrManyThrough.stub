<?php

namespace Hypervel\Database\Eloquent\Relations;

use Closure;
use Hypervel\Contracts\Database\Query\Expression;
use Hypervel\Contracts\Support\Arrayable;
use Hypervel\Database\Eloquent\Builder;
use Hypervel\Database\Eloquent\Model;
use Hypervel\Database\Eloquent\ModelNotFoundException;
use Hypervel\Database\Query\Builder as QueryBuilder;
use Hypervel\Database\UniqueConstraintViolationException;

/*
 * A stub's docblock replaces the source's, so the class docblock and each method's docblock repeat
 * the source and add only analyzer-only types. Keep them in sync with the source. Native signatures
 * repeat the source too, except return types naming a collection, which stub validation cannot
 * declare; their docblocks type them. As in the Relation stub, the existence query returns the
 * builder it is given.
 */

/**
 * @template TRelatedModel of Model
 * @template TIntermediateModel of Model
 * @template TDeclaringModel of Model
 * @template TResult
 *
 * @extends Relation<TRelatedModel, TIntermediateModel, TResult>
 */
abstract class HasOneOrManyThrough extends Relation
{
    /**
     * Prepare the query builder for query execution.
     *
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>  $columns
     * @return builder-of<TRelatedModel>
     */
    protected function prepareQueryBuilder(array $columns = ['*']): Builder;

    /**
     * Add the constraints for an internal relationship existence query.
     *
     * Unlike Laravel, which inherits Relation's types, the parent query is the declaring model's: Relation's
     * parent here is the intermediate model.
     *
     * @template TQuery of Builder<TRelatedModel>
     * @template TParentQuery of Builder<TDeclaringModel>
     *
     * @param  TQuery  $query
     * @param  TParentQuery  $parentQuery
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>|model-property<TRelatedModel>|Expression|'*'  $columns
     * @return TQuery
     */
    public function getRelationExistenceQuery(Builder $query, Builder $parentQuery, mixed $columns = ['*']): Builder;

    /**
     * Get the first related model record matching the attributes or instantiate it.
     *
     * @param  array<model-property<TRelatedModel>, mixed>  $attributes
     * @param  array<model-property<TRelatedModel>, mixed>|(Closure(): array<model-property<TRelatedModel>, mixed>)  $values
     * @return TRelatedModel
     */
    public function firstOrNew(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Get the first record matching the attributes. If the record is not found, create it.
     *
     * @param  array<model-property<TRelatedModel>, mixed>  $attributes
     * @param  array<model-property<TRelatedModel>, mixed>|(Closure(): array<model-property<TRelatedModel>, mixed>)  $values
     * @return TRelatedModel
     */
    public function firstOrCreate(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Attempt to create the record. If a unique constraint violation occurs, attempt to find the matching record.
     *
     * @param  array<model-property<TRelatedModel>, mixed>  $attributes
     * @param  array<model-property<TRelatedModel>, mixed>|(Closure(): array<model-property<TRelatedModel>, mixed>)  $values
     * @return TRelatedModel
     *
     * @throws UniqueConstraintViolationException
     */
    public function createOrFirst(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Get the first record matching the attributes, including trashed records, and restore it. If the record is not found, create it.
     *
     * @param  array<model-property<TRelatedModel>, mixed>  $attributes
     * @param  array<model-property<TRelatedModel>, mixed>|(Closure(): array<model-property<TRelatedModel>, mixed>)  $values
     * @return TRelatedModel
     */
    public function restoreOrCreate(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Attempt to create the record. If a unique constraint violation occurs, find the matching record, including trashed records, and restore it.
     *
     * @param  array<model-property<TRelatedModel>, mixed>  $attributes
     * @param  array<model-property<TRelatedModel>, mixed>|(Closure(): array<model-property<TRelatedModel>, mixed>)  $values
     * @return TRelatedModel
     *
     * @throws UniqueConstraintViolationException
     */
    public function createOrRestore(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Create or update a related record matching the attributes, and fill it with values.
     *
     * @param  array<model-property<TRelatedModel>, mixed>  $attributes
     * @param  array<model-property<TRelatedModel>, mixed>|(Closure(): array<model-property<TRelatedModel>, mixed>)  $values
     * @return TRelatedModel
     */
    public function updateOrCreate(array $attributes, Closure|array $values = []): Model;

    /**
     * Create a related record matching the attributes, or increment the existing record.
     *
     * @param  array<model-property<TRelatedModel>, mixed>  $attributes
     * @param  model-property<TRelatedModel>  $column
     * @param  array<model-property<TRelatedModel>, mixed>  $extra
     * @return TRelatedModel
     */
    public function incrementOrCreate(array $attributes, string $column = 'count', float|int $default = 1, float|int $step = 1, array $extra = []): Model;

    /**
     * Add a basic where clause to the query, and return the first result.
     *
     * @param  array<int|model-property<TRelatedModel>, mixed>|(Closure(($operator is null ? model-query-of<TRelatedModel> : QueryBuilder)): mixed)|model-property<TRelatedModel>  $column
     * @return null|TRelatedModel
     */
    public function firstWhere(Closure|string|array $column, mixed $operator = null, mixed $value = null, string $boolean = 'and'): ?Model;

    /**
     * Execute the query and get the first related model.
     *
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>  $columns
     * @return null|TRelatedModel
     */
    public function first(array $columns = ['*']): ?Model;

    /**
     * Execute the query and get the first result or throw an exception.
     *
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>  $columns
     * @return TRelatedModel
     *
     * @throws ModelNotFoundException<TRelatedModel>
     */
    public function firstOrFail(array $columns = ['*']): Model;

    /**
     * Execute the query and get the first result or call a callback.
     *
     * @template TValue
     *
     * @param  (Closure(): TValue)|list<model-property<TRelatedModel>|Expression|'*'>  $columns
     * @param  null|(Closure(): TValue)  $callback
     * @return TRelatedModel|TValue
     */
    public function firstOr(Closure|array $columns = ['*'], ?Closure $callback = null): mixed;

    /**
     * Find a related model by its primary key.
     *
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>  $columns
     * @return ($id is Model ? null|TRelatedModel : ($id is (array<mixed>|Arrayable<array<array-key, mixed>>) ? collection-of<int, TRelatedModel> : null|TRelatedModel))
     */
    public function find(mixed $id, array $columns = ['*']);

    /**
     * Find multiple related models by their primary keys.
     *
     * @param  array<mixed>|Arrayable<array<array-key, mixed>>  $ids
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>  $columns
     * @return collection-of<int, TRelatedModel>
     */
    public function findMany(Arrayable|array $ids, array $columns = ['*']);

    /**
     * Find a related model by its primary key or throw an exception.
     *
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>  $columns
     * @return ($id is Model ? TRelatedModel : ($id is (array<mixed>|Arrayable<array<array-key, mixed>>) ? collection-of<int, TRelatedModel> : TRelatedModel))
     *
     * @throws ModelNotFoundException<TRelatedModel>
     */
    public function findOrFail(mixed $id, array $columns = ['*']);

    /**
     * Find a related model by its primary key or call a callback.
     *
     * @template TValue
     *
     * @param  (Closure(): TValue)|list<model-property<TRelatedModel>|Expression|'*'>|model-property<TRelatedModel>|'*'  $columns
     * @param  null|(Closure(): TValue)  $callback
     * @return (
     *     $id is Model ? TRelatedModel|TValue : (
     *         $id is (Arrayable<array<array-key, mixed>>|array<mixed>)
     *         ? collection-of<int, TRelatedModel>|TValue
     *         : TRelatedModel|TValue
     *     )
     * )
     */
    public function findOr(mixed $id, Closure|array|string $columns = ['*'], ?Closure $callback = null): mixed;

    /**
     * Execute the query as a "select" statement.
     *
     * @param  array<int, model-property<TRelatedModel>|Expression|'*'>  $columns
     * @return collection-of<int, TRelatedModel>
     */
    public function get(array $columns = ['*']);

    /**
     * Chunk the results of the query.
     *
     * @param  callable(collection-of<int, TRelatedModel>, int): mixed  $callback
     */
    public function chunk(int $count, callable $callback): bool;

    /**
     * Chunk the results of a query by comparing numeric IDs.
     *
     * @param  callable(collection-of<int, TRelatedModel>, int): mixed  $callback
     */
    public function chunkById(int $count, callable $callback, ?string $column = null, ?string $alias = null): bool;

    /**
     * Chunk the results of a query by comparing IDs in descending order.
     *
     * @param  callable(collection-of<int, TRelatedModel>, int): mixed  $callback
     */
    public function chunkByIdDesc(int $count, callable $callback, ?string $column = null, ?string $alias = null): bool;
}
