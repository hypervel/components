<?php

namespace Hypervel\Database\Eloquent;

use Closure;
use Hypervel\Contracts\Database\Query\Expression;
use Hypervel\Contracts\Support\Arrayable;
use Hypervel\Database\Eloquent\Relations\Relation;
use Hypervel\Database\MultipleRecordsFoundException;
use Hypervel\Database\Query\Builder as QueryBuilder;
use Hypervel\Database\UniqueConstraintViolationException;
use RuntimeException;
use SortDirection;
use UnitEnum;

/*
 * A stub's docblock replaces the source's, so the class docblock and each method's docblock repeat
 * the source and add only analyzer-only types: builder-of, collection-of, model-property and
 * relation-of. Keep them in sync with the source. Native signatures repeat the source too, except
 * return types naming a collection, which stub validation cannot declare; their docblocks type them.
 *
 * The polymorphic relationship queries need no stub: RelationshipQueryCallbackExtension types their
 * callbacks from the given morph types. Upstream's SoftDeletes stub is replaced by SoftDeletingMacros.
 */

/**
 * Forwarded query methods operate on this builder, so their value type is TModel.
 * Keep toBase() and getQuery() unparameterized because raw queries return stdClass rows.
 *
 * @template TModel of Model
 *
 * @property-read $this|HigherOrderBuilderProxy $orWhere
 * @property-read $this|HigherOrderBuilderProxy $whereNot
 * @property-read $this|HigherOrderBuilderProxy $orWhereNot
 *
 * @method $this whereCan(UnitEnum|string $ability, mixed $user = null)
 * @method $this withCan(UnitEnum|string|list<UnitEnum|string> $abilities, mixed $user = null)
 * @method $this fetchUsing(mixed ...$fetchUsing)
 * @method $this useWritePdo()
 *
 * @mixin QueryBuilder<int, TModel>
 */
class Builder
{
    /**
     * Add a relationship count / exists condition to the query.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  null|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)  $callback
     *
     * @throws RuntimeException
     */
    public function has(Relation|string $relation, string $operator = '>=', Expression|int $count = 1, string $boolean = 'and', ?Closure $callback = null): static;

    /**
     * Add a relationship count / exists condition to the query.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  null|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)  $callback
     */
    public function doesntHave(Relation|string $relation, string $boolean = 'and', ?Closure $callback = null): static;

    /**
     * Add a relationship count / exists condition to the query with where clauses.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  null|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)  $callback
     */
    public function whereHas(Relation|string $relation, ?Closure $callback = null, string $operator = '>=', Expression|int $count = 1): static;

    /**
     * Add a relationship count / exists condition to the query with where clauses and an "or".
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  null|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)  $callback
     */
    public function orWhereHas(Relation|string $relation, ?Closure $callback = null, string $operator = '>=', Expression|int $count = 1): static;

    /**
     * Add a relationship count / exists condition to the query with where clauses.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  null|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)  $callback
     */
    public function whereDoesntHave(Relation|string $relation, ?Closure $callback = null): static;

    /**
     * Add a relationship count / exists condition to the query with where clauses and an "or".
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  null|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)  $callback
     */
    public function orWhereDoesntHave(Relation|string $relation, ?Closure $callback = null): static;

    /**
     * Add a basic where clause to a relationship query.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  array<mixed>|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)|Expression|string  $column
     */
    public function whereRelation(Relation|string $relation, Closure|string|array|Expression $column, mixed $operator = null, mixed $value = null): static;

    /**
     * Add an "or where" clause to a relationship query.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  array<mixed>|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)|Expression|string  $column
     */
    public function orWhereRelation(Relation|string $relation, Closure|string|array|Expression $column, mixed $operator = null, mixed $value = null): static;

    /**
     * Add a basic count / exists condition to a relationship query.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  array<mixed>|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)|Expression|string  $column
     */
    public function whereDoesntHaveRelation(Relation|string $relation, Closure|string|array|Expression $column, mixed $operator = null, mixed $value = null): static;

    /**
     * Add an "or where" clause to a relationship query.
     *
     * @template TRelation of string
     * @template TRelatedModel of Model
     *
     * @param  TRelation|Relation<TRelatedModel, *, *>  $relation
     * @param  array<mixed>|(Closure(($relation is string ? builder-of<TModel, TRelation> : builder-of<TRelatedModel>)): mixed)|Expression|string  $column
     */
    public function orWhereDoesntHaveRelation(Relation|string $relation, Closure|string|array|Expression $column, mixed $operator = null, mixed $value = null): static;

    /**
     * Add a relationship count / exists condition to the query with where clauses.
     *
     * Also load the relationship with the same condition.
     *
     * @template TRelation of string
     *
     * @param  TRelation  $relation
     * @param  null|(Closure(($relation is literal-string ? builder-of<TModel, TRelation> : Builder<*>)|relation-of<TModel, TRelation>): mixed)  $callback
     */
    public function withWhereHas(string $relation, ?Closure $callback = null, string $operator = '>=', Expression|int $count = 1): static;

    /**
     * Add a basic where clause to a relationship query and eager-load the relationship with the same conditions.
     *
     * @template TRelation of string
     *
     * @param  TRelation  $relation
     * @param  array<mixed>|(Closure(($relation is literal-string ? builder-of<TModel, TRelation> : Builder<*>)|relation-of<TModel, TRelation>): mixed)|Expression|string  $column
     */
    public function withWhereRelation(string $relation, Closure|string|array|Expression $column, mixed $operator = null, mixed $value = null): static;

    /**
     * Specify relationships that should be eager loaded.
     *
     * @template TRelation of string
     *
     * @param  TRelation|array<int|TRelation, array<mixed>|(callable(relation-of<TModel, TRelation>): mixed)|string>  $relations
     * @param  null|(Closure(relation-of<TModel, TRelation>): mixed)|string  $callback
     */
    public function with(array|string $relations, Closure|string|null $callback = null): static;

    /**
     * Set the relationships that should be eager loaded while removing any previously added eager loading specifications.
     *
     * @template TRelation of string
     *
     * @param  string|array<int|TRelation, array<mixed>|(callable(relation-of<TModel, TRelation>): mixed)|string>  $relations
     */
    public function withOnly(array|string $relations): static;

    /**
     * Create and return an un-saved model instance.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @return TModel
     */
    public function make(array $attributes = []): Model;

    /**
     * Save a new model and return the instance.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @return TModel
     */
    public function create(array $attributes = []): Model;

    /**
     * Save a new model and return the instance without raising model events.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @return TModel
     */
    public function createQuietly(array $attributes = []): Model;

    /**
     * Create a collection of models from plain arrays.
     *
     * @param  array<mixed>  $items
     * @return collection-of<int, TModel>
     */
    public function hydrate(array $items);

    /**
     * Create a collection of models from a raw query.
     *
     * @param  array<mixed>  $bindings
     * @return collection-of<int, TModel>
     */
    public function fromQuery(string $query, array $bindings = []);

    /**
     * Find a model by its primary key.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return ($id is Model ? null|TModel : ($id is (array<mixed>|Arrayable<array<array-key, mixed>>) ? collection-of<int, TModel> : null|TModel))
     */
    public function find(mixed $id, array|string $columns = ['*']);

    /**
     * Find a sole model by its primary key.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return TModel
     *
     * @throws ModelNotFoundException<TModel>
     * @throws MultipleRecordsFoundException
     */
    public function findSole(mixed $id, array|string $columns = ['*']): Model;

    /**
     * Find multiple models by their primary keys.
     *
     * @param  Arrayable|array<mixed>  $ids
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return collection-of<int, TModel>
     */
    public function findMany(Arrayable|array $ids, array|string $columns = ['*']);

    /**
     * Find a model by its primary key or throw an exception.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return ($id is Model ? TModel : ($id is (array<mixed>|Arrayable<array<array-key, mixed>>) ? collection-of<int, TModel> : TModel))
     *
     * @throws ModelNotFoundException<TModel>
     */
    public function findOrFail(mixed $id, array|string $columns = ['*']);

    /**
     * Find a model by its primary key or return fresh model instance.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return ($id is Model ? TModel : ($id is (array<mixed>|Arrayable<array<array-key, mixed>>) ? collection-of<int, TModel> : TModel))
     */
    public function findOrNew(mixed $id, array|string $columns = ['*']);

    /**
     * Find a model by its primary key or call a callback.
     *
     * @template TValue
     *
     * @param  (Closure(): TValue)|array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @param  null|(Closure(): TValue)  $callback
     * @return (
     *     $id is Model ? TModel|TValue : (
     *         $id is (Arrayable<array<array-key, mixed>>|array<mixed>)
     *         ? collection-of<int, TModel>|TValue
     *         : TModel|TValue
     *     )
     * )
     */
    public function findOr(mixed $id, Closure|array|string $columns = ['*'], ?Closure $callback = null): mixed;

    /**
     * Execute the query and get the first result.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return null|TModel
     */
    public function first(array|string $columns = ['*']);

    /**
     * Get the first record matching the attributes or instantiate it.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @param  array<model-property<TModel>, mixed>|(Closure(): array<model-property<TModel>, mixed>)  $values
     * @return TModel
     */
    public function firstOrNew(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Get the first record matching the attributes. If the record is not found, create it.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @param  array<model-property<TModel>, mixed>|(Closure(): array<model-property<TModel>, mixed>)  $values
     * @return TModel
     */
    public function firstOrCreate(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Execute the query and get the first result or throw an exception.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return TModel
     *
     * @throws ModelNotFoundException<TModel>
     */
    public function firstOrFail(array|string $columns = ['*']): Model;

    /**
     * Execute the query and get the first result or call a callback.
     *
     * @template TValue
     *
     * @param  (Closure(): TValue)|list<model-property<TModel>|Expression|'*'>  $columns
     * @param  null|(Closure(): TValue)  $callback
     * @return TModel|TValue
     */
    public function firstOr(Closure|array $columns = ['*'], ?Closure $callback = null): mixed;

    /**
     * Attempt to create the record. If a unique constraint violation occurs, attempt to find the matching record.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @param  array<model-property<TModel>, mixed>|(Closure(): array<model-property<TModel>, mixed>)  $values
     * @return TModel
     *
     * @throws UniqueConstraintViolationException
     */
    public function createOrFirst(array $attributes = [], Closure|array $values = []): Model;

    /**
     * Create or update a record matching the attributes, and fill it with values.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @param  array<model-property<TModel>, mixed>|(Closure(): array<model-property<TModel>, mixed>)  $values
     * @return TModel
     */
    public function updateOrCreate(array $attributes, Closure|array $values = []): Model;

    /**
     * Create a record matching the attributes, or increment the existing record.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @param  model-property<TModel>  $column
     * @param  array<model-property<TModel>, mixed>  $extra
     * @return TModel
     */
    public function incrementOrCreate(array $attributes, string $column = 'count', float|int $default = 1, float|int $step = 1, array $extra = []): Model;

    /**
     * Save a new model and return the instance. Allow mass-assignment.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @return TModel
     */
    public function forceCreate(array $attributes): Model;

    /**
     * Save a new model instance with mass assignment without raising model events.
     *
     * @param  array<model-property<TModel>, mixed>  $attributes
     * @return TModel
     */
    public function forceCreateQuietly(array $attributes = []): Model;

    /**
     * Update records in the database.
     *
     * @param  array<model-property<TModel>, mixed>  $values
     */
    public function update(array $values): int;

    /**
     * Insert new records or update the existing ones.
     *
     * @param  array<model-property<TModel>, mixed>|array<int, array<model-property<TModel>, mixed>>  $values
     * @param  model-property<TModel>|array<int, model-property<TModel>>  $uniqueBy
     * @param  null|array<int|model-property<TModel>, mixed>  $update
     */
    public function upsert(array $values, array|string $uniqueBy, ?array $update = null): int;

    /**
     * Insert into the database after merging the model's default attributes, setting timestamps, and casting values.
     *
     * @param  array<int, array<model-property<TModel>, mixed>>  $values
     */
    public function fillAndInsert(array $values): bool;

    /**
     * Insert (ignoring errors) into the database after merging the model's default attributes, setting timestamps, and casting values.
     *
     * @param  array<int, array<model-property<TModel>, mixed>>  $values
     */
    public function fillAndInsertOrIgnore(array $values): int;

    /**
     * Insert a record into the database and get its ID after merging the model's default attributes, setting timestamps, and casting values.
     *
     * @param  array<model-property<TModel>, mixed>  $values
     */
    public function fillAndInsertGetId(array $values): int;

    /**
     * Enrich the given values by merging in the model's default attributes, adding timestamps, and casting values.
     *
     * @param  array<int, array<model-property<TModel>, mixed>>  $values
     * @return array<int, array<string, mixed>>
     */
    public function fillForInsert(array $values): array;

    /**
     * Execute the query and get the first result if it's the sole matching record.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return TModel
     *
     * @throws ModelNotFoundException<TModel>
     * @throws MultipleRecordsFoundException
     */
    public function sole(array|string $columns = ['*']): Model;

    /**
     * Add a basic where clause to the query.
     *
     * @param  array<int|model-property<TModel>, mixed>|(Closure(($operator is null ? static : QueryBuilder)): mixed)|Builder<*>|QueryBuilder|Relation<*, *, *>|Expression|model-property<TModel>  $column
     * @return $this
     */
    public function where(array|Closure|self|QueryBuilder|Relation|Expression|string $column, mixed $operator = null, mixed $value = null, string $boolean = 'and'): static;

    /**
     * Add an "or where" clause to the query.
     *
     * A null operator passed as the second of two arguments becomes a comparison with null, which
     * makes a callback a subquery, so the callback type cannot follow the operator here.
     *
     * @param  array<int|model-property<TModel>, mixed>|(Closure(__benevolent<static|QueryBuilder>): mixed)|Builder<*>|QueryBuilder|Relation<*, *, *>|Expression|model-property<TModel>  $column
     */
    public function orWhere(array|Closure|self|QueryBuilder|Relation|Expression|string $column, mixed $operator = null, mixed $value = null): static;

    /**
     * Add a basic where clause to the query, and return the first result.
     *
     * @param  array<int|model-property<TModel>, mixed>|(Closure(($operator is null ? static : QueryBuilder)): mixed)|Builder<*>|QueryBuilder|Relation<*, *, *>|Expression|model-property<TModel>  $column
     * @return null|TModel
     */
    public function firstWhere(array|Closure|self|QueryBuilder|Relation|Expression|string $column, mixed $operator = null, mixed $value = null, string $boolean = 'and'): ?Model;

    /**
     * Add a basic "where not" clause to the query.
     *
     * @param  array<int|model-property<TModel>, mixed>|(Closure(($operator is null ? static : QueryBuilder)): mixed)|Builder<*>|QueryBuilder|Relation<*, *, *>|Expression|model-property<TModel>  $column
     */
    public function whereNot(array|Closure|self|QueryBuilder|Relation|Expression|string $column, mixed $operator = null, mixed $value = null, string $boolean = 'and'): static;

    /**
     * Add an "or where not" clause to the query.
     *
     * @param  array<int|model-property<TModel>, mixed>|(Closure(($operator is null ? static : QueryBuilder)): mixed)|Builder<*>|QueryBuilder|Relation<*, *, *>|Expression|model-property<TModel>  $column
     */
    public function orWhereNot(array|Closure|self|QueryBuilder|Relation|Expression|string $column, mixed $operator = null, mixed $value = null): static;

    /**
     * Specify attributes that should be added to any new models created by this builder.
     *
     * The given key / value pairs will also be added as where conditions to the query.
     *
     * @param  array<model-property<TModel>, mixed>|Expression|model-property<TModel>  $attributes
     */
    public function withAttributes(Expression|array|string $attributes, mixed $value = null, bool $asConditions = true): static;

    /**
     * Add an "order by" clause for a timestamp to the query.
     *
     * @param  null|Closure|Builder<*>|QueryBuilder|Relation<*, *, *>|Expression|model-property<TModel>  $column
     */
    public function latest(Closure|self|QueryBuilder|Relation|Expression|string|null $column = null): static;

    /**
     * Add an "order by" clause for a timestamp to the query.
     *
     * @param  null|Closure|Builder<*>|QueryBuilder|Relation<*, *, *>|Expression|model-property<TModel>  $column
     */
    public function oldest(Closure|self|QueryBuilder|Relation|Expression|string|null $column = null): static;

    /**
     * Execute the query as a "select" statement.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return collection-of<int, TModel>
     */
    public function get(array|string $columns = ['*']);

    /**
     * Get the hydrated models without eager loading.
     *
     * @param  array<int, model-property<TModel>|Expression|'*'>|model-property<TModel>|'*'  $columns
     * @return array<int, TModel>
     */
    public function getModels(array|string $columns = ['*']): array;

    /**
     * Get a single column's value from the first result of a query.
     *
     * @param  Expression|model-property<TModel>  $column
     */
    public function value(Expression|string $column): mixed;

    /**
     * Get a single column's value from the first result of a query if it's the sole matching record.
     *
     * @param  Expression|model-property<TModel>  $column
     *
     * @throws ModelNotFoundException<TModel>
     * @throws MultipleRecordsFoundException
     */
    public function soleValue(Expression|string $column): mixed;

    /**
     * Get a single column's value from the first result of the query or throw an exception.
     *
     * @param  Expression|model-property<TModel>  $column
     *
     * @throws ModelNotFoundException<TModel>
     */
    public function valueOrFail(Expression|string $column): mixed;

    /**
     * Chunk the results of the query.
     *
     * @param  callable(collection-of<int, TModel>, int): mixed  $callback
     */
    public function chunk(int $count, callable $callback): bool;

    /**
     * Chunk the results of a query by comparing IDs.
     *
     * @param  callable(collection-of<int, TModel>, int): mixed  $callback
     */
    public function chunkById(int $count, callable $callback, ?string $column = null, ?string $alias = null): bool;

    /**
     * Chunk the results of a query by comparing IDs in descending order.
     *
     * @param  callable(collection-of<int, TModel>, int): mixed  $callback
     */
    public function chunkByIdDesc(int $count, callable $callback, ?string $column = null, ?string $alias = null): bool;

    /**
     * Chunk the results of a query by comparing IDs in a given order.
     *
     * @param  callable(collection-of<int, TModel>, int): mixed  $callback
     */
    public function orderedChunkById(int $count, callable $callback, ?string $column = null, ?string $alias = null, SortDirection|bool $descending = false): bool;

    /**
     * Increment a column's value by a given amount.
     *
     * @param  Expression|model-property<TModel>  $column
     * @param  array<model-property<TModel>, mixed>  $extra
     */
    public function increment(Expression|string $column, mixed $amount = 1, array $extra = []): int;

    /**
     * Decrement a column's value by a given amount.
     *
     * @param  Expression|model-property<TModel>  $column
     * @param  array<model-property<TModel>, mixed>  $extra
     */
    public function decrement(Expression|string $column, mixed $amount = 1, array $extra = []): int;

    /**
     * Increment the given column's values by the given amounts.
     *
     * @param  array<model-property<TModel>, float|int|numeric-string>  $columns
     * @param  array<model-property<TModel>, mixed>  $extra
     */
    public function incrementEach(array $columns, array $extra = []): int;

    /**
     * Decrement the given column's values by the given amounts.
     *
     * @param  array<model-property<TModel>, float|int|numeric-string>  $columns
     * @param  array<model-property<TModel>, mixed>  $extra
     */
    public function decrementEach(array $columns, array $extra = []): int;

    /**
     * Qualify the given column name by the model's table.
     *
     * @param  Expression|model-property<TModel>  $column
     */
    public function qualifyColumn(Expression|string $column): string;

    /**
     * Qualify the given columns with the model's table.
     *
     * @param  array<Expression|model-property<TModel>>  $columns
     * @return array<string>
     */
    public function qualifyColumns(array $columns): array;
}
