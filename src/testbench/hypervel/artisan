#!/usr/bin/env php
<?php

declare(strict_types=1);

use Hypervel\Console\Application as ConsoleApplication;
use Hypervel\Contracts\Console\Kernel as ConsoleKernelContract;
use Hypervel\Contracts\Foundation\Application as ApplicationContract;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Output\ConsoleOutput;

ini_set('display_errors', 'on');
ini_set('display_startup_errors', 'on');
ini_set('memory_limit', '1G');

error_reporting(E_ALL);

! defined('BASE_PATH') && define('BASE_PATH', __DIR__);

require __DIR__ . '/bootstrap/autoload.php';

$committedTestbenchRoot = realpath(__DIR__ . '/..');

if (
    is_string($committedTestbenchRoot)
    && is_file($committedTestbenchRoot . '/testbench.yaml')
    && is_file($committedTestbenchRoot . '/bin/testbench')
) {
    fwrite(
        STDERR,
        "This committed Testbench skeleton artisan entrypoint must not be run directly. Use php src/testbench/bin/testbench ... so Testbench boots a disposable runtime copy.\n"
    );
    exit(1);
}

$httpBootstrapCommands = ['serve', 'watch'];
$input = new ArgvInput;

if (in_array(ConsoleApplication::resolveCommandName($input), $httpBootstrapCommands, true)) {
    // Forked server workers inherit this flag; separate Artisan processes must not.
    $_SERVER['APP_RUNNING_IN_CONSOLE'] = 'false';
}

(function () use ($input) {
    /** @var ApplicationContract $app */
    $app = require BASE_PATH . '/bootstrap/app.php';

    $kernel = $app->make(ConsoleKernelContract::class);

    $output = new ConsoleOutput;

    $status = $kernel->handle($input, $output);

    $kernel->terminate($input, $status);

    exit($status);
})();
