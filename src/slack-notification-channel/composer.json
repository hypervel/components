{
    "name": "hypervel/slack-notification-channel",
    "description": "Slack notification channels for Hypervel.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "notifications",
        "slack",
        "swoole",
        "hypervel"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.2",
        "hypervel/collections": "^0.4",
        "hypervel/conditionable": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/http": "^0.4",
        "hypervel/notifications": "^0.4",
        "hypervel/support": "^0.4",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\Notifications\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\Notifications\\SlackChannelServiceProvider"
            ]
        }
    }
}
