{
    "name": "hypervel/opentelemetry",
    "type": "library",
    "description": "OpenTelemetry metrics, traces, and logs for Hypervel.",
    "license": "MIT",
    "keywords": [
        "php",
        "hypervel",
        "opentelemetry",
        "observability",
        "metrics",
        "tracing"
    ],
    "authors": [
        {
            "name": "Albert Chen",
            "email": "albert@hypervel.org"
        },
        {
            "name": "Raj Siva-Rajah",
            "homepage": "https://github.com/binaryfire"
        }
    ],
    "support": {
        "issues": "https://github.com/hypervel/components/issues",
        "source": "https://github.com/hypervel/components"
    },
    "autoload": {
        "psr-4": {
            "Hypervel\\OpenTelemetry\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-swoole": "^6.2.2",
        "guzzlehttp/guzzle": "^7.15.1",
        "guzzlehttp/promises": "^2.5.2",
        "hypervel/cache": "^0.4",
        "hypervel/config": "^0.4",
        "hypervel/console": "^0.4",
        "hypervel/container": "^0.4",
        "hypervel/context": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/coordinator": "^0.4",
        "hypervel/core": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/database": "^0.4",
        "hypervel/events": "^0.4",
        "hypervel/foundation": "^0.4",
        "hypervel/http": "^0.4",
        "hypervel/http-server": "^0.4",
        "hypervel/log": "^0.4",
        "hypervel/object-pool": "^0.4",
        "hypervel/pool": "^0.4",
        "hypervel/queue": "^0.4",
        "hypervel/redis": "^0.4",
        "hypervel/routing": "^0.4",
        "hypervel/server": "^0.4",
        "hypervel/server-process": "^0.4",
        "hypervel/support": "^0.4",
        "hypervel/view": "^0.4",
        "hypervel/websocket-server": "^0.4",
        "monolog/monolog": "^3.1",
        "open-telemetry/api": "^1.10",
        "open-telemetry/context": "^1.5",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "open-telemetry/sem-conv": "^1.38",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "symfony/console": "^8.1",
        "symfony/http-foundation": "^8.1"
    },
    "suggest": {
        "ext-protobuf": "Strongly recommended for high-throughput OTLP protobuf encoding.",
        "hypervel/grpc": "Enables gRPC client and server instrumentation (^0.4).",
        "hypervel/scout": "Enables Scout search-engine instrumentation (^0.4)."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "Hypervel\\OpenTelemetry\\OpenTelemetryServiceProvider"
            ],
            "aliases": {
                "OpenTelemetry": "Hypervel\\OpenTelemetry\\Facades\\OpenTelemetry"
            }
        }
    }
}
